<h2>Enter Marks</h2>

<form action="addMarks" method="post">

Student Username:
<input type="text" name="student"><br><br>

Subject:
<input type="text" name="subject"><br><br>

Exam Type:
<select name="examType">
    <option>Internal</option>
    <option>Mid Term</option>
    <option>Final</option>
</select>

<br><br>

Marks:
<input type="number" name="marks"><br><br>

Total:
<input type="number" name="total"><br><br>

Date:
<input type="date" name="date">

<br><br>

<input type="submit" value="Save">

</form>